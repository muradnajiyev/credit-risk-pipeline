# Image
AIRFLOW_IMAGE_NAME=my-airflow-image3:3.1.0
AIRFLOW_PROJ_DIR=./airflow
AIRFLOW_UID=50000

# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:your_password@postgres/airflow
AIRFLOW__CORE__FERNET_KEY=your_fernet_key
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_FOLDER=/opt/airflow/dags/
AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK=true
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO
AIRFLOW__CORE__AUTH_MANAGER=airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-api-server:8080/execution/
AIRFLOW__API__SECRET_KEY=your_api_secret_key
AIRFLOW__API_AUTH__JWT_SECRET=your_jwt_secret

# Postgres
POSTGRES_USER=airflow
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=airflow

# MinIO
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_SERVER_URL=http://minio:9000
MINIO_BROWSER_REDIRECT_URL=http://your_vm_ip:9001

# Spark PostgreSQL credentials
PG_USER=your_pg_user
PG_PASSWORD=your_pg_password
